PORT=4000
JWT_SECRET=replace-this-with-a-long-random-secret
# Vercel reserves the JWT_ prefix, so hosted deploys use SIS_JWT_SECRET instead.
SIS_JWT_SECRET=replace-this-with-a-long-random-secret

# embedded = runs a temporary MySQL server automatically (no installation needed)
# external = connects to your own MySQL server using the settings below
DB_MODE=embedded
DB_AUTO_INIT=true

# DB_MODE=external
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=sis_db

# MYSQL_VERSION=8.4.x
