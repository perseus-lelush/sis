{
  "name": "sis",
  "version": "1.0.0",
  "private": true,
  "description": "Integrated Student Information System with attendance, LMS, billing, and notifications",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:init": "npm run db:init -w server",
    "seed": "npm run seed -w server",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
